<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.cdsframework</groupId>
    <artifactId>ice-parent</artifactId>
    <packaging>pom</packaging>
    <version>4.0.1-SNAPSHOT</version>

    <name>ICE Parent</name>
    <description>Immunization Calculation Engine - Multi-Module Parent</description>

    <modules>
        <module>ice-rules-kjar</module>
        <module>opencds-ice-service</module>
    </modules>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.1</version>
    </parent>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>25</java.version>
        <maven.compiler.proc>full</maven.compiler.proc>

        <spring-boot.version>4.0.1</spring-boot.version>
        <opencds.version>7.0.1</opencds.version>

        <drools.version>10.1.0</drools.version>
        <cxf.version>4.1.4</cxf.version>
        <guava.version>33.5.0-jre</guava.version>

        <jaxb-maven-plugin.version>4.0.12</jaxb-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.drools</groupId>
                <artifactId>drools-core</artifactId>
                <version>10.1.0-20250815</version>
            </dependency>
            <dependency>
                <groupId>org.drools</groupId>
                <artifactId>drools-kiesession</artifactId>
                <version>10.1.0-20250814</version>
            </dependency>
            <dependency>
                <groupId>org.drools</groupId>
                <artifactId>drools-engine-classic</artifactId>
                <version>${drools.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opencds</groupId>
                <artifactId>opencds-vmr-evaluation</artifactId>
                <version>${opencds.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opencds</groupId>
                <artifactId>opencds-evaluation</artifactId>
                <version>${opencds.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-core</artifactId>
                <version>3.27.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>my-local-repo</id>
            <url>file://${project.basedir}/local-repo</url>
            <releases>
                <checksumPolicy>ignore</checksumPolicy>
            </releases>
        </repository>
    </repositories>
</project>
